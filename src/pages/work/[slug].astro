---
import type { ImageMetadata } from 'astro';
import { getCollection, render } from 'astro:content';
import Board from '../../components/Board.astro';
import Preview from '../../components/Preview.astro';
import Station from '../../components/Station.astro';
import Layout from '../../layouts/Layout.astro';
import { iconUrl } from '../../data/icons.ts';
import { loadPortfolio } from '../../data/portfolio.ts';
import { fullName, pageTitle } from '../../data/profile.ts';
import { findScreenshots } from '../../data/screenshots.ts';
import { lighthouseMethod, workFactsView } from '../../data/views.ts';
import { formatDay, formatMonthRange } from '../../lib/format.ts';
import { breadcrumbNode, graph, workCrumbs, workNode } from '../../lib/jsonld.ts';
import { techCategories } from '../../schemas/tech.ts';
import { statusMeanings } from '../../schemas/work.ts';

export async function getStaticPaths() {
  return (await getCollection('work')).map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const data = await loadPortfolio();
const work = data.works.find(item => item.id === entry.id)!;
const facts = workFactsView(entry.id, data.facts, work.data);
const techs = new Map(data.techs.map(tech => [tech.id, tech]));
const icon = iconUrl(facts.icon);
// Present only when `bun run capture-screenshots` has captured this Work's site; the build never fails or fetches for it.
const masters = import.meta.glob<{ default: ImageMetadata }>('/src/assets/screenshots/*/*.webp', { eager: true });
const screenshots = findScreenshots(masters, entry.id);
const crumbs = workCrumbs(work);
// A Metric's leading figure is the reading; the words after it qualify it.
const figure = (value: string) => /^([\d.,]+%?)(.*)$/s.exec(value) ?? [value, value, ''];
const { Content } = await render(entry);
---

<Layout title={pageTitle(data.profile, work.data.title)} description={work.data.summary}
  jsonLd={graph(workNode(work, data.facts.works[work.id], data.techs), breadcrumbNode(work))}>
  <article>
    <Station>
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          {crumbs.map((crumb, index) => <li><a href={crumb.path} aria-current={index === crumbs.length - 1 ? 'page' : undefined}>{crumb.name}</a></li>)}
        </ol>
      </nav>
      <header>
        <div class="work-id">
          {icon ? <img src={icon} alt="" width="48" height="48" /> : <span class="mono" aria-hidden="true">{work.data.title.charAt(0).toUpperCase()}</span>}
          <h1>{work.data.title}</h1>
        </div>
        {/* The visible credit for the JSON-LD author and publisher. */}
        <p class="byline">By {fullName(data.profile)}</p>
        <p class="lede"><strong>{work.data.tagline}</strong></p>
        <p class="lede">{work.data.summary}</p>
        {work.data.caveat && <p class="lede caveat">{work.data.caveat}</p>}
      </header>
    </Station>

    <div class="wrap">
      <Preview title={work.data.title} site={work.data.site} screenshots={screenshots} />

      <section class="block" aria-labelledby="facts">
        <h2 id="facts">Facts</h2>
        <dl class="facts">
          <dt>Role</dt><dd>{work.data.role}</dd>
          <dt>Kind</dt><dd>{work.data.kind}</dd>
          <dt>Status</dt><dd>{statusMeanings[work.data.status]}</dd>
          {work.data.site && <><dt>Site</dt><dd><a href={work.data.site}>{new URL(work.data.site).host}</a></dd></>}
          {facts.lighthouse && <><dt>Lighthouse</dt><dd>
            <span class="big">Performance {facts.lighthouse.performance} · Accessibility {facts.lighthouse.accessibility} · Best practices {facts.lighthouse.bestPractices} · SEO {facts.lighthouse.seo},</span>
            measured by <a href={facts.lighthouse.analysisUrl}>PageSpeed Insights</a> {lighthouseMethod()}, {formatDay(facts.lighthouse.measuredAt)}
          </dd></>}
          {facts.repoUrl && <><dt>Repository</dt><dd><a href={facts.repoUrl}>{work.data.repo}</a></dd></>}
          {facts.sourcePrivate && <><dt>Repository</dt><dd>Source private</dd></>}
          {facts.packages.map(pkg => <>
            <dt>{pkg.registry} {pkg.name}</dt>
            <dd>{pkg.published ? <><a href={pkg.url}>{pkg.version}</a>, released {formatDay(pkg.releasedAt)}</> : `not published on ${pkg.registry}`}</dd>
          </>)}
          {facts.release && <><dt>Latest release</dt><dd>{facts.release.tag}, {formatDay(facts.release.publishedAt)}</dd></>}
          {facts.license && <><dt>Licence</dt><dd>{facts.license}</dd></>}
          {facts.active && <><dt>Active</dt><dd>{formatMonthRange(facts.active.from, facts.active.to)}</dd></>}
          {facts.commitCount !== undefined && <><dt>Commits</dt><dd>{facts.commitCount}</dd></>}
          {facts.pkgbuildCount !== undefined && <><dt>PKGBUILDs</dt><dd>{facts.pkgbuildCount}</dd></>}
          {facts.rules && <><dt>Rules</dt><dd>{facts.rules.total} sourced rules: {facts.rules.head} for the head and {facts.rules.total - facts.rules.head} for markup in the body or anywhere in the page</dd></>}
        </dl>
      </section>

      <section class="block" aria-labelledby="stack">
        <h2 id="stack">Stack</h2>
        <ul class="stack">{work.data.stack.map(id => {
          const tech = techs.get(id)!;
          const href = techCategories[tech.category].skills ? `/skills/#${id}` : tech.url;
          return <li><a href={href}>{tech.label}</a></li>;
        })}</ul>
      </section>

      {work.data.highlights.length > 0 && (
        <section class="block" aria-labelledby="highlights">
          <h2 id="highlights">Highlights</h2>
          <ul class="highlights">{work.data.highlights.map(text => <li>{text}</li>)}</ul>
        </section>
      )}

      {work.data.metrics.length > 0 && (
        <Board id="metrics" caption="Metrics" columns={['Metric', 'Value', 'Measured', 'Source']}>
          {work.data.metrics.map(metric => {
            const [, lead, rest] = figure(metric.value);
            return (
              <tr>
                <td class="what">{metric.label}</td>
                <td class="num"><strong>{lead}</strong>{rest}</td>
                <td class="when">{formatDay(metric.measuredAt)}</td>
                <td>{metric.source.url ? <a href={metric.source.url}>{metric.source.label}</a> : metric.source.label}</td>
              </tr>
            );
          })}
        </Board>
      )}

      <div class="prose block"><Content /></div>
    </div>
  </article>
</Layout>
