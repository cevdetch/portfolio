---
import Layout from '../layouts/Layout.astro';
import { pageTitle } from '../data/profile.ts';
import { siteProfile } from '../data/site-profile.ts';

const home = import.meta.env.BASE_URL;
---

<Layout title={pageTitle(siteProfile, 'Page not found')} description="The page you requested could not be found." noindex={true} canonical={false} image={false}>
  {/* The C at the scale of the viewport: six blocks in --brand, the message in its mouth, and the odd block, top
      right, is the gold key home. The source order reads message first, then the key. */}
  <div class="wrap lost">
    <div class="giant-c">
      <div class="mouth">
        <h1>Page not found</h1>
        <p>The page may have moved, or the address may be incorrect.</p>
      </div>
      <a class="key odd" href={home}>Go to the home page</a>
      <span class="cell c1"></span><span class="cell c2"></span><span class="cell c4"></span>
      <span class="cell c7"></span><span class="cell c8"></span><span class="cell c9"></span>
    </div>
  </div>
</Layout>
