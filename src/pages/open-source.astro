---
import Board from '../components/Board.astro';
import Station from '../components/Station.astro';
import WorkId from '../components/WorkId.astro';
import Layout from '../layouts/Layout.astro';
import { loadPortfolio } from '../data/portfolio.ts';
import { fullName, pageTitle } from '../data/profile.ts';
import { contributionSpan, contributionTotals, orderWorks, upstreamGroups, workFactsView } from '../data/views.ts';
import { formatDay, formatMonth } from '../lib/format.ts';
import { techCategories } from '../schemas/tech.ts';

const data = await loadPortfolio();
const techs = new Map(data.techs.map(tech => [tech.id, tech]));
const works = new Map(data.works.map(work => [work.id, work]));
const packageWorks = orderWorks(data.works).map(work => ({ work, facts: workFactsView(work.id, data.facts, work.data) }))
  .filter(({ facts }) => facts.packages.length > 0 || facts.pkgbuildCount !== undefined);
const groups = upstreamGroups(data.facts.contributions, data.contributions);
const totals = contributionTotals(groups);
const span = contributionSpan(data.facts.contributions, data.contributions, data.facts.refreshedAt, true);
---

<Layout title={pageTitle(data.profile, 'Open source')} description={`The packages ${fullName(data.profile)} publishes, from npm tools to Arch Linux PKGBUILDs, and the fixes accepted into other open-source projects such as Immich and Starlight.`}>
  <Station>
    <h1>Open source</h1>
  </Station>
  <div class="wrap">
    <Board id="packages" caption="Packages" columns={['Work', 'Package', 'Released']}>
      {packageWorks.map(({ work, facts }) => <>
        {facts.packages.map(pkg => (
          <tr>
            <td class="what"><WorkId id={work.id} title={work.data.title} icon={facts.icon} /></td>
            <td>{pkg.registry} {pkg.name}</td>
            <td class="where">{pkg.published ? <><a href={pkg.url}>{pkg.version}</a>, {formatDay(pkg.releasedAt)}</> : `not published on ${pkg.registry}`}</td>
          </tr>
        ))}
        {facts.pkgbuildCount !== undefined && facts.repoUrl && (
          <tr>
            <td class="what"><WorkId id={work.id} title={work.data.title} icon={facts.icon} /></td>
            <td>{facts.pkgbuildCount} PKGBUILDs in <a href={facts.repoUrl}>{work.data.repo}</a></td>
            <td class="where"></td>
          </tr>
        )}
      </>)}
    </Board>

    <section class="block" aria-labelledby="contributions">
      <h2 id="contributions">Contributions</h2>
      <p class="summary">{totals.pulls} merged pull requests to {totals.upstreams} upstream repositories{span && `, ${formatMonth(span.from)} to ${span.ongoing ? 'present' : formatMonth(span.to)}`}.</p>
      {/* One board, a row group per Upstream: the repository, the Techs and Works its fixes touch, then its pulls. */}
      <table class="board grouped" aria-labelledby="contributions">
        <thead><tr><th scope="col">Merged</th><th scope="col">Pull request</th></tr></thead>
        {groups.map(group => (
          <tbody>
            <tr class="group">
              <th colspan="2" scope="rowgroup">
                <a href={group.url}>{group.repo}</a>
                {(group.techs.length > 0 || group.works.length > 0) && (
                  <span class="touches">
                    {group.techs.map((id, index) => {
                      const tech = techs.get(id)!;
                      const href = techCategories[tech.category].skills ? `/skills/#${id}` : tech.url;
                      return <>{index > 0 && ', '}<a href={href}>{tech.label}</a></>;
                    })}
                    {group.works.length > 0 && group.techs.length > 0 && ' · '}
                    {group.works.map((id, index) => <>{index > 0 && ', '}<a href={`/work/${id}/`}>{works.get(id)!.data.title}</a></>)}
                  </span>
                )}
              </th>
            </tr>
            {group.pulls.map(pull => (
              <tr>
                <td class="when">{formatDay(pull.mergedAt)}</td>
                <td><a href={pull.url}>#{pull.number}</a> {pull.title}{pull.note && <span class="note"> ({pull.note})</span>}</td>
              </tr>
            ))}
          </tbody>
        ))}
      </table>
    </section>
  </div>
</Layout>
