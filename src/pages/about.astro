---
import Board from '../components/Board.astro';
import Portrait from '../components/Portrait.astro';
import Station from '../components/Station.astro';
import Layout from '../layouts/Layout.astro';
import { fullName, languageItem, pageTitle } from '../data/profile.ts';
import { loadPortfolio } from '../data/portfolio.ts';
import { splitOnTitles } from '../data/views.ts';
import { formatMonth } from '../lib/format.ts';

const data = await loadPortfolio();
const { profile } = data;
const works = new Map(data.works.map(work => [work.id, work]));
// The about story names Works by title; each becomes a link to its Work page.
const workLinks = new Map(data.works.map(work => [work.data.title, `/work/${work.id}/`] as const));
const [lede, ...paragraphs] = (profile.about ?? [profile.bio]).map(text => splitOnTitles(text, [...workLinks.keys()]));
---

<Layout title={pageTitle(profile, 'About')} description={`${fullName(profile)}, software developer and Gymnasium student: the web tools, the open-source fixes, the Linux packaging, and the studies, writing and languages.`}>
  <Station>
    <h1>About {fullName(profile)}</h1>
    {lede && <p class="lede intro">{lede.map(part => workLinks.has(part) ? <a href={workLinks.get(part)}>{part}</a> : part)}</p>}
    <Portrait slot="aside" class="portrait" alt={fullName(profile)} priority />
  </Station>
  <div class="wrap">
    {paragraphs.length > 0 && <div class="prose block">{paragraphs.map(parts => <p>{parts.map(part => workLinks.has(part) ? <a href={workLinks.get(part)}>{part}</a> : part)}</p>)}</div>}

    <Board id="experience" caption="Experience" columns={['Dates', 'Role', 'Where']} widths={['24%', '54%', '22%']}>
      {data.experience.map(entry => (
        <tr>
          <td class="when">{formatMonth(entry.start)} to {entry.end ? formatMonth(entry.end) : 'present'}</td>
          <td>
            <strong>{entry.role}</strong>
            {entry.highlights.length > 0 && <ul class="dashes">{entry.highlights.map(text => <li>{text}</li>)}</ul>}
          </td>
          <td class="where">{entry.organisation}</td>
        </tr>
      ))}
    </Board>

    <Board id="education" caption="Education" columns={['Dates', 'Study', 'Where']} widths={['24%', '54%', '22%']}>
      {data.education.map(entry => (
        <tr>
          <td class="when">{formatMonth(entry.start)} to {formatMonth(entry.end)}{entry.expected && ', expected'}</td>
          <td><strong>{entry.credential}</strong>{entry.field && <>, {entry.field}</>}{entry.note && <p class="note">{entry.note}</p>}</td>
          <td class="where">{entry.institution}</td>
        </tr>
      ))}
    </Board>

    <section class="block two" aria-labelledby="languages">
      <h2 id="languages">Languages</h2>
      <ul class="dashes">{profile.languages.map(language => <li>{languageItem(language)}</li>)}</ul>
    </section>

    <section class="block two" aria-labelledby="interests">
      <h2 id="interests">Interests</h2>
      <ul class="dashes">
        {profile.interests.map(interest => (
          <li>{interest.label}: {interest.work
            ? <a href={works.get(interest.work)!.data.site}>{interest.details}</a>
            : interest.details}</li>
        ))}
      </ul>
    </section>
  </div>
</Layout>
