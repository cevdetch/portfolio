---
import SiteNav from '../components/SiteNav.astro';
import Layout from '../layouts/Layout.astro';
import { fullName, languageItem } from '../data/profile.ts';
import { loadPortfolio } from '../data/portfolio.ts';
import { splitOnTitles } from '../data/views.ts';
import { formatMonth } from '../lib/format.ts';

const data = await loadPortfolio();
const { profile } = data;
const works = new Map(data.works.map(work => [work.id, work]));
const writing = works.get(profile.writing)!;
// The about story names Works by title; each becomes a link to its Work page.
const workLinks = new Map(data.works.map(work => [work.data.title, `/work/${work.id}/`] as const));
const paragraphs = (profile.about ?? [profile.bio]).map(text => splitOnTitles(text, [...workLinks.keys()]));
---

<Layout title="About - Cevdet" description={`${fullName(profile)}, software developer and Gymnasium student: the web tools, the open-source fixes, the Linux packaging, and the studies, writing and languages.`}>
  <SiteNav />
  <main>
    <h1>About {fullName(profile)}</h1>
    {paragraphs.map(parts => <p>{parts.map(part => workLinks.has(part) ? <a href={workLinks.get(part)}>{part}</a> : part)}</p>)}
    <section aria-labelledby="experience">
      <h2 id="experience">Experience</h2>
      <ul>
        {data.experience.map(entry => (
          <li>
            <p>{entry.role}, {entry.organisation} ({formatMonth(entry.start)} to {entry.end ? formatMonth(entry.end) : 'present'})</p>
            {entry.highlights.length > 0 && <ul>{entry.highlights.map(text => <li>{text}</li>)}</ul>}
          </li>
        ))}
      </ul>
    </section>
    <section aria-labelledby="education">
      <h2 id="education">Education</h2>
      <ul>
        {data.education.map(entry => (
          <li>
            {entry.credential}{entry.field && <>, {entry.field}</>}, {entry.institution}{' '}
            ({formatMonth(entry.start)} to {formatMonth(entry.end)}{entry.expected && ', expected'}).
            {entry.note && <> {entry.note}</>}
          </li>
        ))}
      </ul>
    </section>
    <section aria-labelledby="languages">
      <h2 id="languages">Languages</h2>
      <ul>
        {profile.languages.map(language => <li>{languageItem(language)}</li>)}
      </ul>
    </section>
    <section aria-labelledby="interests">
      <h2 id="interests">Interests</h2>
      <ul>
        {profile.interests.map(interest => (
          <li>{interest.label}: {interest.work
            ? <a href={works.get(interest.work)!.data.site}>{interest.details}</a>
            : interest.details}</li>
        ))}
      </ul>
    </section>
    <section aria-labelledby="writing">
      <h2 id="writing">Writing</h2>
      <p>Essays and poems on <a href={writing.data.site}>{writing.data.title}</a>.</p>
    </section>
  </main>
</Layout>
