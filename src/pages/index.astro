---
import SiteNav from '../components/SiteNav.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Layout from '../layouts/Layout.astro';
import { loadPortfolio } from '../data/portfolio.ts';
import { featuredWorks, upstreamGroups } from '../data/views.ts';
import { graph, personNode, profilePageNode, websiteNode } from '../lib/jsonld.ts';

const data = await loadPortfolio();
const { profile } = data;
const groups = upstreamGroups(data.facts.contributions, data.contributions);
const total = groups.reduce((sum, group) => sum + group.pulls.length, 0);
const highlighted = groups.flatMap(group => group.pulls.filter(pull => pull.highlight));
---

<Layout title={`${profile.name} - ${profile.jobTitle}`} description={profile.headline}
  jsonLd={graph([profilePageNode(profile), personNode(profile, data.techs), websiteNode(profile)])}>
  <SiteNav />
  <main>
    <h1>{profile.name}</h1>
    <p>{profile.jobTitle}</p>
    <p>{profile.headline}</p>
    <p>{profile.bio}</p>
    <section aria-labelledby="featured">
      <h2 id="featured">Featured work</h2>
      <ul>
        {featuredWorks(data.works).map(work => <li><a href={`/work/${work.id}/`}>{work.data.title}</a>: {work.data.tagline}</li>)}
      </ul>
      <p><a href="/work/">All work</a></p>
    </section>
    <section aria-labelledby="open-source">
      <h2 id="open-source">Open source</h2>
      <p>{total} merged pull requests to {groups.length} upstream projects.</p>
      {highlighted.length > 0 && (
        <ul>{highlighted.map(pull => <li><a href={pull.url}>{pull.upstream}#{pull.number}</a>: {pull.title}{pull.note && <> ({pull.note})</>}</li>)}</ul>
      )}
      <p><a href="/open-source/">Packages and Contributions</a></p>
    </section>
    <p><a href="/hire/">Hire Cevdet</a> · <a href="/cv.pdf">CV (PDF)</a></p>
    <SocialLinks socials={profile.socials} />
  </main>
</Layout>
