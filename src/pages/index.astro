---
import SiteNav from '../components/SiteNav.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Layout from '../layouts/Layout.astro';
import { fullName } from '../data/profile.ts';
import { loadPortfolio } from '../data/portfolio.ts';
import { contributionHighlights, featuredWorks, homeMetrics, recentlyShipped, splitOnTitles, upstreamGroups, upstreamLabel } from '../data/views.ts';
import { formatDay, joinList } from '../lib/format.ts';
import { graph, personNode, profilePageNode, websiteNode } from '../lib/jsonld.ts';

const data = await loadPortfolio();
const { profile } = data;
const groups = upstreamGroups(data.facts.contributions, data.contributions);
const highlights = contributionHighlights(groups);
const metrics = homeMetrics(profile.homeMetrics, data.works);
const shipped = recentlyShipped(data.facts, data.works, data.contributions, 5);

// The proof line names each proofWorks entry by title (validated); each becomes a link to its Work page.
const proofWorks = profile.proofWorks.map(id => data.works.find(work => work.id === id)!);
const proofLinks = new Map(proofWorks.map(work => [work.data.title, `/work/${work.id}/`] as const));
const proofParts = splitOnTitles(profile.proof, proofWorks.map(work => work.data.title));
---

<Layout title={`${fullName(profile)} - ${profile.jobTitle}`} description={profile.headline}
  jsonLd={graph([profilePageNode(profile), personNode(profile, data.techs), websiteNode(profile)])}>
  <SiteNav />
  <main>
    <h1>{fullName(profile)}</h1>
    <p>{profile.specialisation}</p>
    <p>{proofParts.map(part => proofLinks.has(part) ? <a href={proofLinks.get(part)}>{part}</a> : part)}</p>
    <p><a href="/hire/">Work with me</a> · <a href="/cv.pdf">CV (PDF)</a></p>
    <section aria-labelledby="numbers">
      <h2 id="numbers">Numbers</h2>
      <dl>
        {metrics.map(({ metric }) => (
          <div>
            <dt>{metric.value}</dt>
            <dd>{metric.label}{metric.source.url ? <> (<a href={metric.source.url}>{metric.source.label}</a>)</> : ` (${metric.source.label})`}</dd>
          </div>
        ))}
      </dl>
    </section>
    <section aria-labelledby="featured">
      <h2 id="featured">Featured work</h2>
      <ul>
        {featuredWorks(data.works).map(work => <li><a href={`/work/${work.id}/`}>{work.data.title}</a>: {work.data.tagline}</li>)}
      </ul>
      <p><a href="/work/">All work</a></p>
    </section>
    <section aria-labelledby="open-source">
      <h2 id="open-source">Open source</h2>
      {highlights.length > 0 && (
        <ul>
          {highlights.map(({ group, pull }) => (
            <li>
              <a href={group.url}>{upstreamLabel(group.repo, data.contributions)}</a> <a href={pull.url}>#{pull.number}</a>: {pull.title}
              {pull.note && <> ({pull.note})</>}
            </li>
          ))}
        </ul>
      )}
      <ul>
        {data.contributions.themes.map(theme => (
          <li><a href="/open-source/">{theme.lead} {joinList(theme.upstreams.map(repo => upstreamLabel(repo, data.contributions)), 'and')}{theme.note ? `, ${theme.note}` : ''}.</a></li>
        ))}
      </ul>
      {shipped.length > 0 && (
        <>
          <h3>Recently shipped</h3>
          <ul>
            {shipped.map(item => (
              <li>
                {item.kind === 'release'
                  ? <><a href={`/work/${item.work.id}/`}>{item.work.data.title}</a> released <a href={item.url}>{item.package} {item.version}</a>, {formatDay(item.at)}</>
                  : <>{item.label} merged <a href={item.url}>#{item.number}</a>: {item.title}, {formatDay(item.at)}</>}
              </li>
            ))}
          </ul>
        </>
      )}
    </section>
    <section aria-labelledby="about">
      <h2 id="about">About</h2>
      <p>{profile.jobTitle}</p>
      <p>{profile.bio}</p>
      <p><a href="/about/">More about Cevdet</a></p>
    </section>
    <SocialLinks socials={profile.socials} />
    <p><a href="/hire/">Work with me</a></p>
  </main>
</Layout>
