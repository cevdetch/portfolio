---
import Station from '../components/Station.astro';
import Layout from '../layouts/Layout.astro';
import { loadPortfolio } from '../data/portfolio.ts';
import { fullName, pageTitle } from '../data/profile.ts';
import { skillGroups } from '../data/views.ts';

const data = await loadPortfolio();
const groups = skillGroups(data.techs, data.works);
---

<Layout title={pageTitle(data.profile, 'Skills')} description={`The programming languages, frameworks, tools and platforms ${fullName(data.profile)} works with, with links to the projects that use them.`}>
  <Station>
    <h1>Skills</h1>
  </Station>
  <div class="wrap">
    {groups.map(group => {
      // The board carries the skills a Work uses; the rest follow as a compact run of links, never as empty rows.
      const used = group.techs.filter(({ works }) => works.length > 0);
      const bare = group.techs.filter(({ works }) => works.length === 0);
      return (
        <section class="block" aria-labelledby={group.category}>
          <h2 id={group.category}>{group.label}</h2>
          {used.length > 0 && (
            <table class="board fixed" aria-labelledby={group.category}>
              <colgroup><col style="inline-size: 30%" /><col style="inline-size: 70%" /></colgroup>
              <thead><tr><th scope="col">Skill</th><th scope="col">Used in</th></tr></thead>
              <tbody>
                {used.map(({ tech, works }) => (
                  <tr id={tech.id}>
                    <td class="what"><a href={tech.url}>{tech.label}</a></td>
                    <td>{works.map((work, index) => <>{index > 0 && ', '}<a href={`/work/${work.id}/`}>{work.data.title}</a></>)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
          {bare.length > 0 && <ul class="stack">{bare.map(({ tech }) => <li id={tech.id}><a href={tech.url}>{tech.label}</a></li>)}</ul>}
        </section>
      );
    })}
  </div>
</Layout>
