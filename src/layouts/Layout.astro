---
import brand from '../brand.json';
import { siteConfig } from '../config.ts';
import { serializeJsonLd } from '../lib/jsonld.ts';
import { parseSiteNoindex, resolveSeo, type LayoutProps } from '../lib/seo.ts';

type Props = LayoutProps & { jsonLd?: object };

const { jsonLd } = Astro.props;
const seo = await resolveSeo(Astro.props, {
  site: Astro.site?.href,
  base: import.meta.env.BASE_URL,
  // Preserve request encoding; Astro.url normalizes repeated percent encoding.
  url: new URL(Astro.request.url),
  mode: import.meta.env.DEV ? 'dev' : Astro.isPrerendered ? 'build' : 'server',
  siteNoindex: parseSiteNoindex(import.meta.env['SITE_NOINDEX']),
  socialImages: siteConfig.socialImages,
});
---

<!doctype html>
<html lang={seo.lang} dir={seo.dir}>
  <head
    data-starter-page-v1={seo.pagePolicy ? JSON.stringify(seo.pagePolicy) : undefined}
    data-starter-social-v1={seo.generatedImageUrl}
  >
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{seo.title}</title>
    <link rel="icon" href={seo.faviconHref} />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={seo.description} />
    <meta name="theme-color" content={brand.themeColor} />
    {jsonLd && <script is:inline type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />}
    {seo.canonicalUrl && <link rel="canonical" href={seo.canonicalUrl} />}
    {seo.robotsNoindex && <meta name="robots" content="noindex" />}
    {seo.social && (
      <>
        <meta property="og:type" content="website" />
        <meta property="og:url" content={seo.social.url} />
        <meta property="og:title" content={seo.title} />
        <meta property="og:description" content={seo.description} />
        <meta property="og:image" content={seo.social.imageUrl} />
        {seo.social.imageAlt !== undefined && <meta property="og:image:alt" content={seo.social.imageAlt} />}
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}
  </head>
  <body>
    <slot />
  </body>
</html>
