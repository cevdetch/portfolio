---
import { socialLabels } from '../data/profile.ts';
import type { Profile } from '../schemas/profile.ts';

interface Props { socials: Profile['socials'] }
const { socials } = Astro.props;
---

<ul>
  {socials.map(social => <li><a href={social.url} rel="me">{socialLabels[social.network]}</a></li>)}
</ul>
