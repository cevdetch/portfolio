---
import { fullName } from '../data/profile.ts';
import { siteProfile } from '../data/site-profile.ts';
import Mark from './Mark.astro';
import SchemeToggle from './SchemeToggle.astro';

const links = [
  ['/work/', 'Work'], ['/open-source/', 'Open source'], ['/skills/', 'Skills'], ['/uses/', 'Uses'], ['/about/', 'About'], ['/hire/', 'Hire'],
] as const;
const path = Astro.url.pathname;
// The page itself is the current page; a page inside a section, such as a Work page, marks its section.
const current = (href: string) => path === href ? 'page' : path.startsWith(href) ? 'true' : undefined;
---

<header class="site-head">
  <div class="wrap">
    <a class="home" href="/" aria-current={path === '/' ? 'page' : undefined}><Mark /><span class="word">{fullName(siteProfile)}</span></a>
    <nav class="site-nav" aria-label="Site">
      <ul>
        {links.map(([href, label]) => <li><a href={href} aria-current={current(href)}>{label}</a></li>)}
      </ul>
    </nav>
    <SchemeToggle />
  </div>
</header>
