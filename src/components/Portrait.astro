---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { portraitFile } from '../data/portrait.ts';

interface Props { alt: string }
const { alt } = Astro.props;
// The portrait the Person's image shows, when `pnpm prepare-portrait` has written it; the page renders without it.
const portraits = import.meta.glob<{ default: ImageMetadata }>('/src/assets/portrait/*.jpg', { eager: true });
const portrait = portraits[`/src/assets/portrait/${portraitFile}`]?.default;
---

{portrait && (
  // AVIF with a JPEG fallback, at 1x and 2x of 240 CSS px; the qualities are the encoder defaults in astro.config.mjs.
  <Picture src={portrait} formats={['avif']} fallbackFormat="jpg" width={240} height={240} widths={[240, 480]} sizes="240px"
    alt={alt} loading="eager" />
)}
