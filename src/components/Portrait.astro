---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { portraitFile } from '../data/portrait.ts';

interface Props {
  alt: string;
  /** Set where the portrait is the page's largest contentful paint, so the browser fetches it first. */
  priority?: boolean;
}
const { alt, priority = false } = Astro.props;
// The portrait the Person's image shows, when `pnpm prepare-portrait` has written it; the page renders without it.
const portraits = import.meta.glob<{ default: ImageMetadata }>('/src/assets/portrait/*.jpg', { eager: true });
const portrait = portraits[`/src/assets/portrait/${portraitFile}`]?.default;
---

{portrait && (
  // AVIF with a JPEG fallback, at 1x, 1.5x and 2x of 240 CSS px; the qualities are the encoder defaults in astro.config.mjs.
  <Picture src={portrait} formats={['avif']} fallbackFormat="jpg" width={240} height={240} widths={[240, 360, 480]} sizes="240px"
    alt={alt} loading="eager" fetchpriority={priority ? 'high' : undefined} />
)}
