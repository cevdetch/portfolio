{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm exec astro preview --host 127.0.0.1 --port 4321",
      "startServerReadyPattern": "4321",
      "url": [
        "http://127.0.0.1:4321/", "http://127.0.0.1:4321/work/", "http://127.0.0.1:4321/work/deadhead/",
        "http://127.0.0.1:4321/open-source/", "http://127.0.0.1:4321/skills/", "http://127.0.0.1:4321/uses/",
        "http://127.0.0.1:4321/about/", "http://127.0.0.1:4321/hire/"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci/mobile" }
  }
}
