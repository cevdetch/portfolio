{
  "ci": {
    "collect": {
      "startServerCommand": "bunx astro preview --host 127.0.0.1 --port 4390",
      "startServerReadyPattern": "127.0.0.1:4390",
      "settings": {
        "ignoreStatusCode": true, "disableFullPageScreenshot": true, "chromeFlags": "--force-dark-mode",
        "onlyCategories": ["accessibility"]
      },
      "numberOfRuns": 1
    },
    "assert": {
      "aggregationMethod": "median",
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 1 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci/dark" }
  }
}
