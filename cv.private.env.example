# Copy to cv.private.env (gitignored) and fill in. These fields exist only in the
# locally rendered full CV: pnpm build && pnpm cv:private
# Every field is optional.

# Full name for the full CV only.
CV_NAME=""

# E.164: country code, no spaces, e.g. +41791234567.
CV_PHONE=""

# City-level, e.g. "City, Country".
CV_LOCATION=""

# City of the first Education entry.
CV_EDUCATION_LOCATION=""
