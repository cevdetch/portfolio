{
  "name": "portfolio",
  "type": "module",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "packageManager": "bun@1.4.5",
  "engines": {
    "node": ">=24.8.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "test": "bun test tests/unit",
    "test:build": "node --test tests/build/*.test.ts",
    "build": "astro build",
    "verify:output": "bun scripts/verify-output.ts",
    "lint:html": "bun scripts/lint-html.ts",
    "verify:portfolio": "bun scripts/verify-portfolio.ts",
    "lint:unused": "knip",
    "verify": "bun --bun run check && bun run lint:unused && bun run test && bun run test:build && bun --bun run build && bun --bun run verify:output && bun --bun run lint:html && bun --bun run verify:portfolio",
    "fetch-facts": "bun --env-file-if-exists=.env scripts/fetch-facts.ts",
    "capture-screenshots": "bun scripts/capture-screenshots.ts",
    "prepare-portrait": "bun scripts/prepare-portrait.ts",
    "cv:private": "bun scripts/cv-private.ts",
    "lighthouse": "astro build --site http://127.0.0.1:4390 && bun scripts/lighthouse.ts",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.3",
    "astro": "^7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/sitemap": "3.7.4",
    "@lhci/cli": "0.16.0",
    "@types/node": "24.8.0",
    "deadhead": "0.4.0",
    "knip": "6.49.0",
    "parse5": "8.0.1",
    "satori": "0.33.5",
    "schema-dts": "2.1.0",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  }
}
